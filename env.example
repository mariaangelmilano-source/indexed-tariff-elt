# Local (default): nothing to set.
WAREHOUSE_TARGET=duckdb
DUCKDB_PATH=data/warehouse.duckdb

# BigQuery: fill these and run `make cloud`.
# GCP_PROJECT=your-gcp-project-id
# Optional: leave unset in the BigQuery sandbox (no billing) to load straight from disk.
# GCS_LANDING_BUCKET=your-gcp-project-id-tariff-landing
# BQ_LOCATION=US
# BQ_AUTH_METHOD=oauth            # or service-account
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
